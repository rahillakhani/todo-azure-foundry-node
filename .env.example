DATABASE_URL=postgres://user:password@localhost:5432/todo
PORT=3000
WS_PORT=8080

# Frontend (frontend/server.js) and the CORS origin the backend allows.
FRONTEND_PORT=5500
FRONTEND_ORIGIN=http://localhost:5500

# Azure OpenAI / Azure AI Foundry — used by backend/mcpAgent.js for todo
# parsing (chat) and semantic embeddings. All four are required; parseTodo/
# parseTodos/embed throw a clear config error if their deployment is unset.
# Endpoint is the resource's base URL, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://lakhanirj-5288-resource.services.ai.azure.com
# AZURE_OPENAI_ENDPOINT=https://lakhanirj-5288-resource.services.ai.azure.com/api/projects/lakhanirj-5288
AZURE_OPENAI_API_KEY=________
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Only needed if your embedding model's default output dimension doesn't
# match the `todos.embedding` pgvector column (VECTOR(1536) by default, see
# scripts/db/schema.sql) — and only text-embedding-3-* models support
# truncating via this param. Leave unset to use the model's default.
EMBEDDING_DIM=1536
